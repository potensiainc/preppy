{
  "name": "admissionradar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:db": "vitest run tests/integration",
    "worker:once": "tsx --tsconfig scripts/worker-tsconfig.json scripts/worker.ts --once --provider=resend --worker-id=railway-worker --batch=10 --lease-ms=300000 --timeout-ms=240000",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:check": "tsx scripts/db/check-connection.ts",
    "db:backfill:institutions": "tsx --tsconfig scripts/db/tsconfig.json scripts/db/backfill-institutions.ts",
    "db:backfill:opportunities": "tsx --tsconfig scripts/db/tsconfig.json scripts/db/backfill-opportunities.ts",
    "db:backfill:source-bindings": "tsx --tsconfig scripts/db/tsconfig.json scripts/db/backfill-source-bindings.ts",
    "db:preflight:production": "tsx --tsconfig scripts/db/tsconfig.json scripts/production-preflight.ts",
    "db:rehearsal": "tsx --tsconfig scripts/db/tsconfig.json scripts/rehearsal.ts",
    "db:restore-drill": "tsx --tsconfig scripts/db/tsconfig.json scripts/backup-restore-rehearsal.ts",
    "data:import-institution-seed": "tsx --tsconfig scripts/db/tsconfig.json scripts/data/import-institution-seed.ts",
    "collector:http": "tsx --tsconfig scripts/db/tsconfig.json scripts/data/collect-official-main-http.ts",
    "data:live-admissions:5": "tsx --tsconfig scripts/db/tsconfig.json scripts/data/run-five-school-live-admissions.ts",
    "data:production-live-admissions:5": "tsx --tsconfig scripts/db/tsconfig.json scripts/data/run-five-school-production-rollout.ts",
    "preview:seed": "tsx scripts/seed-preview-demo.ts --seed"
  },
  "dependencies": {
    "@tiptap/pm": "3.30.3",
    "@tiptap/react": "3.30.3",
    "@tiptap/starter-kit": "3.30.3",
    "cheerio": "1.2.0",
    "drizzle-orm": "0.45.2",
    "next": "16.3.0",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "robots-parser": "3.0.1",
    "sanitize-html": "2.17.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sanitize-html": "2.16.1",
    "drizzle-kit": "0.31.10",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.0",
    "prettier": "^3.0.0",
    "selfsigned": "5.5.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "4.1.10"
  }
}
